{
  "name": "5-to-5",
  "private": true,
  "version": "0.1.0",
  "description": "5-to-5: a deduction puzzle about hidden neighbor rules on a 5x5 board",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "puzzle": "tsx scripts/cli.ts",
    "bench": "tsx scripts/bench.ts",
    "exp:enumerate": "tsx scripts/experiments/enumerate.ts",
    "exp:bias": "tsx scripts/experiments/bias.ts",
    "exp:dig": "tsx scripts/experiments/dig.ts",
    "exp:calibrate": "tsx scripts/experiments/difficulty-calibration.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
